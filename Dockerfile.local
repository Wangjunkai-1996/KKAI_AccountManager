# 第一阶段：使用轻量级 alpine 作为运行环境
FROM alpine:latest

# 安装运行时依赖
RUN apk add --no-cache \
    chromium \
    chromium-chromedriver \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont

# 设置 Chromium 环境变量
ENV CHROME_BIN=/usr/bin/chromium-browser \
    CHROME_PATH=/usr/lib/chromium/ \
    PLAYWRIGHT_BROWSERS_PATH=/usr/lib/chromium

# 设置工作目录
WORKDIR /app

# 复制本地编译好的二进制文件
COPY bin/openai-login-web-linux ./openai-login-web

# 暴露端口
EXPOSE 8080

# 启动服务
CMD ["./openai-login-web"]
